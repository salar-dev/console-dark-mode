{
  "manifest_version": 3,
  "name": "Dark Mode for Play Console & App Store Connect",
  "short_name": "Console Dark Mode",
  "description": "A carefully crafted dark theme for Google Play Console and App Store Connect. Toggle per site. Never touches other websites.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "author": "Salar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Console Dark Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://play.google.com/console*",
    "https://appstoreconnect.apple.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://play.google.com/console*"
      ],
      "css": [
        "styles/play-console.css"
      ],
      "js": [
        "src/settings.js",
        "src/engine/color.js",
        "src/engine/remap.js",
        "src/sites/playconsole.js",
        "src/badge.js",
        "src/svg-inline.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://appstoreconnect.apple.com/*"
      ],
      "css": [
        "styles/app-store-connect.css"
      ],
      "js": [
        "src/settings.js",
        "src/engine/color.js",
        "src/engine/remap.js",
        "src/sites/appstoreconnect.js",
        "src/badge.js",
        "src/svg-inline.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.google.com/console*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://appstoreconnect.apple.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle dark mode on / off"
    }
  }
}
